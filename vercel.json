{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/analytics", "destination": "/analytics/index.html" },
    { "source": "/en/analytics", "destination": "/analytics/index.html" },
    { "source": "/es/analytics", "destination": "/analytics/index.html" }
  ],
  "headers": [
    {
      "source": "/(en/|es/)?analytics(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
